{
  "name": "@jaykingson/vite-plus-base",
  "version": "0.0.2",
  "description": "Opinionated vite-plus config wrapper for apps and libraries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohannesKonings/vite-plus-base"
  },
  "bin": {
    "vite-plus-base-bingo": "./dist/template/bin/bingo.mjs",
    "vite-plus-base-template": "./dist/template/bin/index.mjs"
  },
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./template/bin": "./dist/template/bin/index.mjs",
    "./template/bin/bingo": "./dist/template/bin/bingo.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "sync-skills": "node --experimental-strip-types scripts/sync-matt-pocock-skills.mts"
  },
  "dependencies": {
    "bingo": "catalog:",
    "bingo-stratum": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite-plus": ">=1.0.0"
  }
}
